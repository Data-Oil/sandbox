<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DataOil.Samples.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings DataOil.Client 0.2.2 and Entity Framework Core 10.0.13 with it. -->
    <PackageReference Include="DataOil.EntityFrameworkCore" Version="0.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataOil.Samples.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
